    "@google/genai": "^1.21.0",
    "@prisma/client": "^6.5.0",
    "@socket.io/admin-ui": "^0.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@xenova/transformers": "^2.17.2",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.13.1",
    "axios-cookiejar-support": "^6.0.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.3",
    "bullmq": "^5.66.1",
    "busboy": "^1.6.0",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
