{
  "name": "asg-web-app-backend",
  "version": "1.0.0",
  "main": "index.js",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "message-worker:campain": "node src/app/modules/student/firebase/messaging/jobs/worker.campaign.js",
    "message-worker:tx": "node src/app/modules/student/firebase/messaging/jobs/worker.tx.js",
    "worker:chat": "node src/app/socket/worker/chat.worker.js",
    "redis-tx": "redis-cli LLEN bull:txQueue:wait && redis-cli LLEN bull:txQueue:active && redis-cli LLEN bull:txQueue:failed",
    "redis-campain": "redis-cli LLEN bull:txCampaign:wait && redis-cli LLEN bull:txCampain:active && redis-cli LLEN bull:txCampain:failed",
    "postinstall": "npx playwright install --with-deps chromium",
    "build": "npm install && npx prisma generate && npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:backup": "cp prisma/schema.prisma prisma/schema.prisma.backup",
    "export:practice-entitlement-catalog": "node scripts/export-practice-entitlement-catalog.js",
    "lint": "eslint src --ignore-path .eslintignore --ext .ts",
    "lint:fixed": "npx eslint src --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "migrate": "npx prisma migrate dev",
    "prisma:format": "npx prisma format"
  },
  "keywords": [],
  "author": "Subroto & Limon CO",
  "license": "ISC",
  "description": "",
