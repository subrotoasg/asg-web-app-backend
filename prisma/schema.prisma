//billing system addon services
enum UsageStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum BillingStatus {
  DRAFT
  PENDING
  APPROVED
  INVOICED
  PAID
  OVERDUE
  DISPUTED
}

enum CalculationMethod {
  MANUAL
  AUTOMATIC
  SYSTEM_GENERATED
}

model serviceUsageLog {
  id String @id @default(uuid()) @db.Uuid

  // Core Relations
  courseId   String  @db.Uuid
  adminId    String  @db.Uuid
  serviceId  String  @db.Uuid
  offeringId String? @db.Uuid

  offeringPriceId       String? @db.Uuid
  defaultServicePriceId String? @db.Uuid

  // Usage Details
  priceType   PriceType
  quantity    Float
  unit        String
  ratePerUnit Decimal   @db.Decimal(65, 10)
  totalAmount Decimal   @db.Decimal(65, 10)
  currency    String    @default("BDT")

  // Time Period
  usageDate    DateTime
  billingMonth Int
  billingYear  Int
  startTime    DateTime?
  endTime      DateTime?

  // Context
  referenceId   String?
  referenceType String?
  metadata      Json?

  // Status & Tracking
  status     UsageStatus @default(ACTIVE)
  isBillable Boolean     @default(true)
  isInvoiced Boolean     @default(false)
  invoiceId  String?     @db.Uuid

  // Approvals
  verifiedBy   String?   @db.Uuid
  verifiedAt   DateTime?
  verifiedNote String?

  // Relations
  course        course                           @relation(fields: [courseId], references: [id])
  admin         admin                            @relation(fields: [adminId], references: [id])
  service       addOnService                     @relation(fields: [serviceId], references: [id])
  offering      courseAdminServiceOffering?      @relation(fields: [offeringId], references: [id])
  offeringPrice courseAdminServiceOfferingPrice? @relation(fields: [offeringPriceId], references: [id])
  defaultPrice  courseDefaultServicePrice?       @relation(fields: [defaultServicePriceId], references: [id])

  // Timestamps
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  isDeleted                   Boolean                    @default(false)
  courseServiceUsageSummary   courseServiceUsageSummary? @relation(fields: [courseServiceUsageSummaryId], references: [id])
  courseServiceUsageSummaryId String?                    @db.Uuid

  @@unique([courseId, adminId, serviceId, usageDate, referenceId])
  @@index([adminId, billingYear, billingMonth])
  @@index([courseId, billingYear, billingMonth])
  @@index([serviceId])
  @@index([status])
  @@index([isInvoiced])
  @@map("service_usage_logs")
}

model courseServiceUsageSummary {
  id String @id @default(uuid()) @db.Uuid

  // Identifiers
  courseId   String  @db.Uuid
  adminId    String  @db.Uuid
  serviceId  String  @db.Uuid
  offeringId String? @db.Uuid

  // Summary Period
  billingYear  Int
  billingMonth Int

  // Usage Summary
  totalQuantity Float
  totalAmount   Decimal @db.Decimal(65, 10)
  currency      String  @default("BDT")

  // Breakdown by type
  hourlyUsage  Float?
  storageUsage Float?
  studentCount Int?
  classCount   Int?
  apiCalls     Int?

  // Status
  status            BillingStatus     @default(DRAFT)
  calculationMethod CalculationMethod @default(SYSTEM_GENERATED)

  // Invoice
  invoiceNumber String?
  invoiceDate   DateTime?
  dueDate       DateTime?
  paidAt        DateTime?

  // Relations
  course   course                      @relation(fields: [courseId], references: [id])
  admin    admin                       @relation(fields: [adminId], references: [id])
  service  addOnService                @relation(fields: [serviceId], references: [id])
  offering courseAdminServiceOffering? @relation(fields: [offeringId], references: [id])

  // Logs Relation
  usageLogs serviceUsageLog[]

  // Timestamps
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  adminMonthlyBill   adminMonthlyBill? @relation(fields: [adminMonthlyBillId], references: [id])
  adminMonthlyBillId String?           @db.Uuid

  @@unique([courseId, adminId, serviceId, billingYear, billingMonth], map: "course_service_usage_summaries_without_offering_unique")
  @@unique([courseId, adminId, serviceId, billingYear, billingMonth, offeringId], map: "course_service_usage_summaries_with_offering_unique")
  @@index([adminId, status])
  @@index([billingYear, billingMonth])
  @@map("course_service_usage_summaries")
}

model adminMonthlyBill {
  id String @id @default(uuid()) @db.Uuid

  adminId      String @db.Uuid
  billingYear  Int
  billingMonth Int

  // Financial Summary
  subtotal    Decimal @db.Decimal(65, 10)
  discount    Decimal @default(0) @db.Decimal(65, 10)
  tax         Decimal @default(0) @db.Decimal(65, 10)
  totalAmount Decimal @db.Decimal(65, 10)
  paidAmount  Decimal @default(0) @db.Decimal(65, 10)
  dueAmount   Decimal @db.Decimal(65, 10)
  currency    String  @default("BDT")

  // Breakdown by Course
  courseBreakdown Json

  // Invoice Details
  invoiceNumber String    @unique
  invoiceDate   DateTime
  dueDate       DateTime
  paymentDate   DateTime?
  paymentMethod String?
  transactionId String?

  // Status
  status BillingStatus @default(DRAFT)

  // Relations
  admin     admin                       @relation(fields: [adminId], references: [id])
  summaries courseServiceUsageSummary[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@unique([adminId, billingYear, billingMonth])
  @@index([status])
  @@index([dueDate])
  @@map("admin_monthly_bills")
}

