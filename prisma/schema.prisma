  id            String   @id @default(uuid()) @db.Uuid
  source        String //asg || afs || acs camp
  transactionId String
  uid           String?
  name          String?
  email         String?
  phone         String?
  HSC           String?
  institution   String?
  productId     String?
  productName   String?
  gateway       String?
  amount        String?
  createdAt     DateTime @default(now())
}

model dailyAyah {
  date         DateTime @id @db.Date
  surah        Int
  ayah         Int
  ayahKey      String
  occasionTags String[]
  payload      Json
  createdAt    DateTime @default(now())

  @@index([ayahKey])
  @@map("daily_ayah")
}

//active chat message store
model activeChat {
  id               String   @id @default(uuid()) @db.Uuid
  classContentId   String?  @db.Uuid
  cycleContentId   String?  @db.Uuid
  studentId        String?  @db.Uuid
  adminId          String?  @db.Uuid
  superAdminId     String?  @db.Uuid
  message          String
  messageCreatedAt BigInt
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  classContent classContent? @relation(fields: [classContentId], references: [id], onDelete: Cascade)
  cycleContent cycleContent? @relation(fields: [cycleContentId], references: [id], onDelete: Cascade)
  student      student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  admin        admin?        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  superAdmin   superAdmin?   @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([classContentId, messageCreatedAt])
  @@index([cycleContentId, messageCreatedAt])
  @@map("activeChats")
}

enum MediaApp {
  FRB
  ACADEMIC
  ADMISSION
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
}

model MediaCredential {
  id String @id @default(cuid())

  app   MediaApp
  keyId String   @unique

  hash String

  version Int @default(1)

  status CredentialStatus @default(ACTIVE)

  validFrom  DateTime
  validUntil DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([app, status])
  @@index([app, status])
}

model event {
  id        String    @id @default(uuid()) @db.Uuid
  startDate DateTime?
  endDate   DateTime?
  metaData  Json?
}

//grand Celebration table
model grandCelebrationAuth {
  id            String    @id @default(uuid()) @db.Uuid
  phone         String    @unique
  photo         String?
  role          String    @default("student")
  isVerifyPhone Boolean   @default(false)
  otp           String?
  count         Int       @default(0)
  expiresAt     DateTime?
  otpSendAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("grandCelebrationAuths")
}
