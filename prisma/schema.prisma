generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_DATABASE_URL")
  directUrl = env("POSTGRES_DIRECT_URL")
}

model AsgWebApp {
  id        Int      @id @default(autoincrement())
  version   Int      @default(1)
  createdAt DateTime @default(now())
}

model superAdmin {
  id                     String                   @id @unique @default(uuid()) @db.Uuid
  email                  String                   @unique
  phone                  String                   @unique
  photo                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  otp                    String?
  otpExpiry              DateTime?
  refreshToken           String?
  role                   Role?                    @default(superAdmin)
  admin                  admin[]
  issueTag               issueTag[]
  courseAdmin            courseAdmin[]
  course                 course[]
  solver                 solver[]
  subject                subject[]
  notificationLogs       notificationLog[]
  IssueTrack             IssueTrack[]
  superAdminXStudentInfo superAdminXStudentInfo[]

  //browser info
  ip                  String?
  userAgent           String?
  browserName         String?
  browserVersion      String?
  osName              String?
  osVersion           String?
  deviceType          String?
  deviceModel         String?
  deviceVendor        String?
  cpuArchitecture     String?
  engineName          String?
  engineVersion       String?
  fp                  String?
  downloadStudentInfo DateTime?
  activeChats         activeChat[]

  @@index([email, phone])
  @@index([email])
  @@index([phone])
  @@map("superAdmin")
}

model superAdminXStudentInfo {
  id               String      @id @unique @default(uuid()) @db.Uuid
  superAdminId     String?     @db.Uuid
  superAdmin       superAdmin? @relation(fields: [superAdminId], references: [id])
  courseOrCycleId  String?
  lastDownloadTime DateTime?

  @@index([superAdminId, courseOrCycleId])
}

model otpAttempts {
  id        String    @id @unique @default(uuid()) @db.Uuid
  email     String?
  phone     String?
  count     Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  otp       String? //used for signup otp verification
  otpExpiry DateTime? //used for sugnup otp verification
}

model admin {
  id                String    @id @unique @default(uuid()) @db.Uuid
  email             String    @unique
  phone             String    @unique
  name              String?
  photo             String?
  status            Status    @default(ACTIVE)
  password          String
  refreshToken      String?
  isDeleted         Boolean   @default(false)
  isPasswordChange  Boolean   @default(false)
  passwordChangedAt DateTime?
  superAdminId      String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  adminId           String?   @db.Uuid
  role              Role?     @default(admin)
  anotherRole       String? //teacher/co-teacher/cx/studio
  //browser info
  ip                String?
  userAgent         String?
  browserName       String?
  browserVersion    String?
  osName            String?
  osVersion         String?
  deviceType        String?
  deviceModel       String?
  deviceVendor      String?
  cpuArchitecture   String?
  engineName        String?
  engineVersion     String?
  fp                String?

  superAdmin                  superAdmin?                 @relation(fields: [superAdminId], references: [id])
  classComment                classComment[]
  classContent                classContent[]
  courseAdmin                 courseAdmin[]
  cycleContent                cycleContent[]
  cycleSubjectChapter         cycleSubjectChapter[]
  cycleSubject                cycleSubject[]
  cycle                       cycle[]
  featured                    featured[]
  liveClass                   liveClass[]
  noticeORroutine             noticeORroutine[]
  courseSubject               courseSubject[]
  classLike                   classLike[]
  pushNotification            pushNotification[]
  notificationLogs            notificationLog[]
  notificationUserStatuses    notificationUserStatus[]
  serviceUsageLogs            serviceUsageLog[]
  courseServiceUsageSummaries courseServiceUsageSummary[]
  adminMonthlyBills           adminMonthlyBill[]
  IssueTrack                  IssueTrack[]
  activeChats                 activeChat[]

  @@index([id, isDeleted, email, phone])
  @@index([email, phone])
  @@index([email])
  @@index([phone])
  @@map("admins")
}

model studentOAuthProvider {
  id        String  @id @unique @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  student   student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  secondaryUid String? //store secondary uid from firebase

  provider    OAuthProvider // GOOGLE | APPLE
  providerUid String // sub from Google or Apple
  email       String? // email returned by provider
  // accessToken  String?                
  // refreshToken String?
  // tokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerUid]) // one account per provider per uid
  @@index([studentId])
  @@index([provider, providerUid])
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model student {
  id                String    @id @unique @default(uuid()) @db.Uuid
  name              String
  phone             String    @unique
  email             String    @unique
  role              Role      @default(student)
  password          String
  address           String?
  profilePhoto      String?
  uid               String?
  batch             String?
  institution       String?
  status            String?   @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  refreshToken      String?
  lastResetPassword DateTime? @default(now())
  lastLogedIn       DateTime? @default(now())

  googleId      String? // Google sub — for quick lookup
  appleId       String? // Apple sub — for quick lookup
  isOAuthUser   Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  emailVerified Boolean   @default(false)
  otp           String?
  otpExpiry     DateTime?

  bannedStatus String?

  hoppCount            Int?    @default(1)
  bloodGroup           String?
  collegeAddress       String?
  collegeName          String?
  collegeSession       String?
  disability           String?
  dob                  String?
  emergencyContact     String?
  fatherIncome         String?
  fatherName           String?
  fatherNid            String?
  fatherProfession     String?
  fatherProfessionType String?
  gender               String?
  group                String?
  guardianMobile       String?
  hscBoard             String?
  hscExam              String?
  hscGpa               String?
  hscReg               String?
  hscRoll              String?
  hscYear              String?
  jscBoard             String?
  jscExam              String?
  jscGpa               String?
  jscReg               String?
  jscRoll              String?
  jscYear              String?
  motherIncome         String?
  motherName           String?
  motherNid            String?
  motherProfession     String?
  motherProfessionType String?
  notes                String?
  permanentDistrict    String?
  permanentDivision    String?
  permanentHouse       String?
  permanentPostOffice  String?
  permanentUnion       String?
  permanentUpazila     String?
  permanentVillage     String?
  presentDistrict      String?
  presentDivision      String?
  presentHouse         String?
  presentPostOffice    String?
  presentUnion         String?
  presentUpazila       String?
  presentVillage       String?
  previousSchool       String?
  religion             String?
  sscBoard             String?
  sscExam              String?
  sscGpa               String?
  sscReg               String?
  sscRoll              String?
  sscYear              String?
  universityChance     String? @default("No")
  universityName       String?
  universityPosition   String?
  universityRollNo     String?
  universitySession    String?
  universitySubject    String?
  remarks              String?
  leads                String? @default("web") //web or app

  answer           answer[]
  classComment     classComment[]
  classLike        classLike[]
  classNote        classNote[]
  course           courseStudent[]
  cycle            cycleStudent[]
  quora            quora[]
  answerComment    answerComment[]
  pushNotification pushNotification[]
  notificationLogs notificationLog[]

  sentNotifications notificationLog[] @relation("senderStudent")

  notificationUserStatuses notificationUserStatus[]
  studentAuthLogs          studentAuthLog[]
  studentOAuthProvider     studentOAuthProvider[]
  studentRestrictions      studentRestriction[]
  activeChats              activeChat[]

  @@index([id, email, phone])
  @@index([email, phone])
  @@index([email])
  @@index([phone])
  @@index([status])
}

enum AuthMethod {
  EMAIL_PASSWORD
  PHONE_OTP
  GOOGLE
  APPLE
}

model studentAuthLog {
  id           String    @id @unique @default(uuid()) @db.Uuid
  studentId    String    @db.Uuid
  student      student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostName     String
  refreshToken String?
  hoppCount    Int?      @default(0)
  lastLogedIn  DateTime? @default(now())

  authMethod  AuthMethod @default(EMAIL_PASSWORD)
  providerUid String? // if OAuth, store the provider's uid

  //browser info
  ip              String?
  userAgent       String?
  browserName     String?
  browserVersion  String?
  osName          String?
  osVersion       String?
  deviceType      String?
  deviceModel     String?
  deviceVendor    String?
  cpuArchitecture String?
  engineName      String?
  engineVersion   String?
  fp              String?

  @@index([studentId, hostName])
  @@index([studentId])
  @@index([hostName])
}

enum RestrictionType {
  FULL
  COMMENT
  REPLY
  CHAT
  LIVE_CLASS
  MEDIA_COMMENT
}

model studentRestriction {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  student   student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type RestrictionType

  reason String?

  bannedAt    DateTime  @default(now())
  bannedUntil DateTime?

  bannedByAdminId String? @db.Uuid

  room_name      String?
  banned_by      String?
  banned_by_name String?
  banned_by_bot  Boolean @default(false)

  @@unique([studentId, type])
  @@index([studentId])
}

model subject {
  id            String          @id @unique @default(uuid()) @db.Uuid
  title         String
  subjectImage  String
  superAdminId  String?         @db.Uuid
  isDeleted     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  chapter       chapter[]
  cycleSubject  cycleSubject[]
  superAdmin    superAdmin?     @relation(fields: [superAdminId], references: [id])
  courseSubject courseSubject[]
}

model chapter {
  id                   String                 @id @unique @default(uuid()) @db.Uuid
  chapterName          String
  chapterImage         String?
  subjectId            String?                @db.Uuid
  isDeleted            Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  chapterNo            String?
  subject              subject?               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseSubjectChapter courseSubjectChapter[]
  cycleSubjectChapter  cycleSubjectChapter[]
}

model course {
  id                  String   @id @unique @default(uuid()) @db.Uuid
  superAdminId        String?  @db.Uuid
  title               String?
  isDeleted           Boolean? @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  cycleAvailable      Boolean? @default(false)
  isCourseFree        Boolean? @default(false)
  courseImage         String?
  Category            String?
  hasApp              Boolean? @default(true)
  Parent              String?
  Permalink           String?
  ProductImage        String?
  SubCategory         String?
  courseId            String?  @unique
  currency_amount     Int?     @default(0)
  productFullName     String?
  productId           String?
  affiliateProductIds String[] @default([])
  productName         String?
  Platinum            Int?     @default(0)
  archieveCourseId    String?  @db.Uuid
  contentOwner        String?  @db.Uuid
  markAsArchieve      Boolean? @default(false)
  facebookGroup       String?
  libraryId           String?
  zoneSecurityKey     String?

  pullzoneId  String?
  clientId    String?
  authKey     String?
  cdnConfig   String?
  bunnyApiKey String?

  pullzoneId2 String?

  courseAdmin                 courseAdmin[]
  courseLookup                courseLookup[]
  courseQuoraDailyLimit       courseQuoraDailyLimit[]
  student                     courseStudent[]
  superAdmin                  superAdmin?                 @relation(fields: [superAdminId], references: [id])
  cycle                       cycle[]
  featured                    featured[]
  noticeORroutine             noticeORroutine[]
  quora                       quora[]
  courseSubject               courseSubject[]
  notificationLogs            notificationLog[]
  courseDefaultServices       courseDefaultService[]
  serviceUsageLogs            serviceUsageLog[]
  courseServiceUsageSummaries courseServiceUsageSummary[]

  @@index([productName, productFullName])
  @@map("courses")
}

model courseStudent {
  courseId   String    @db.Uuid
  studentId  String    @db.Uuid
  accessCode String    @unique
  status     Status    @default(ACTIVE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  enrollDate DateTime?
  course     course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([courseId, studentId])
  @@map("courseStudents")
}

model cycleStudent {
  cycleId    String    @db.Uuid
  studentId  String    @db.Uuid
  accessCode String    @unique
  status     Status    @default(ACTIVE)
  enrollDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cycle      cycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  student    student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([cycleId, studentId])
  @@map("cycleStudents")
}

model courseAdmin {
  adminId                     String                       @db.Uuid
  courseId                    String                       @db.Uuid
  superAdminId                String?                      @db.Uuid
  isDeleted                   Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  admin                       admin                        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  course                      course                       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  superAdmin                  superAdmin?                  @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  courseAdminServiceOfferings courseAdminServiceOffering[]

  @@id([courseId, adminId])
  @@map("courseAdmins")
}

model courseSubject {
  id                   String                 @id @unique @default(uuid()) @db.Uuid
  courseId             String                 @db.Uuid
  title                String?
  isDeleted            Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  adminId              String?                @db.Uuid
  subjectId            String                 @db.Uuid
  courseSubjectImage   String?
  //serial
  serial               Int?                   @default(1)
  courseSubjectChapter courseSubjectChapter[]
  admin                admin?                 @relation(fields: [adminId], references: [id])
  course               course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject              subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("subjects")
}

model courseSubjectChapter {
  id                        String         @id @unique @default(uuid()) @db.Uuid
  isDeleted                 Boolean        @default(false)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  chapterId                 String         @db.Uuid
  courseSubjectId           String         @db.Uuid
  courseSubjectChapterImage String?
  title                     String?
  //serial 
  serial                    Int?           @default(1)
  chapter                   chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  courseSubject             courseSubject  @relation(fields: [courseSubjectId], references: [id], onDelete: Cascade)
  classContent              classContent[]
  liveClass                 liveClass[]

  @@map("chapters")
}

model classContent {
  id                     String               @id @unique @default(uuid()) @db.Uuid
  classTitle             String
  classNo                String
  videoUrl               String
  secondaryUrl           String?
  thumbneil              String?
  isDeleted              Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  adminId                String?              @db.Uuid
  lectureSheet           String?
  practiceSheet          String?
  solutionSheet          String?
  courseSubjectChapterId String               @db.Uuid
  hostingType            String?
  description            String?
  libraryId              String?
  zoneSecurityKey        String?
  instructor             String?
  views                  Int                  @default(0)
  uniqueViews            String[]
  classComment           classComment[]
  admin                  admin?               @relation(fields: [adminId], references: [id])
  courseSubjectChapter   courseSubjectChapter @relation(fields: [courseSubjectChapterId], references: [id], onDelete: Cascade)
  classLike              classLike[]
  classNote              classNote[]
  videoId                String?
  markedBook             String?
  partIndex              Int?

  //serial               
  serial      Int?         @default(1)
  activeChats activeChat[]

  @@map("classContents")
}

model cycle {
  id                  String            @id @unique @default(uuid()) @db.Uuid
  courseId            String            @db.Uuid
  productId           String?
  affiliateProductIds String[]          @default([])
  adminId             String?           @db.Uuid
  title               String
  cycleFullName       String?
  cycleImage          String
  isDeleted           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  archieveCycleId     String?           @db.Uuid
  markAsArchieve      Boolean?          @default(false)
  isCycleFree         Boolean?          @default(false)
  Permalink           String?
  facebookGroup       String?
  libraryId           String?
  currency_amount     Int?              @default(0)
  cycleLookup         cycleLookup[]
  student             cycleStudent[]
  cycleSubject        cycleSubject[]
  admin               admin?            @relation(fields: [adminId], references: [id])
  course              course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  featured            featured[]
  noticeORroutine     noticeORroutine[]
  notificationLogs    notificationLog[]

  @@map("cycles")
}

model libApi {
  id        String @id @unique @default(uuid()) @db.Uuid
  libraryId String @unique
  apiKey    String
}

model cycleSubject {
  id                  String                @id @unique @default(uuid()) @db.Uuid
  cycleId             String                @db.Uuid
  subjectId           String                @db.Uuid
  cycleSubjectImage   String?
  isDeleted           Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  adminId             String?               @db.Uuid
  title               String?
  //serial
  serial              Int?                  @default(1)
  cycleSubjectChapter cycleSubjectChapter[]
  admin               admin?                @relation(fields: [adminId], references: [id])
  cycle               cycle                 @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subject             subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("cycleSubjects")
}

model cycleSubjectChapter {
  id                       String         @id @unique @default(uuid()) @db.Uuid
  cycleSubjectId           String         @db.Uuid
  chapterId                String         @db.Uuid
  cycleSubjectChapterImage String?
  isDeleted                Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  adminId                  String?        @db.Uuid
  title                    String?
  //serial
  serial                   Int?           @default(1)
  cycleContent             cycleContent[]
  admin                    admin?         @relation(fields: [adminId], references: [id])
  chapter                  chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  cycleSubject             cycleSubject   @relation(fields: [cycleSubjectId], references: [id], onDelete: Cascade)
  liveClass                liveClass[]

  @@map("cycleSubjectChapters")
}

model cycleContent {
  id                    String              @id @unique @default(uuid()) @db.Uuid
  cycleSubjectChapterId String              @db.Uuid
  classTitle            String
  classNo               String
  videoUrl              String
  secondaryUrl          String?
  thumbneil             String?
  isDeleted             Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  adminId               String?             @db.Uuid
  lectureSheet          String?
  practiceSheet         String?
  solutionSheet         String?
  hostingType           String?
  description           String?
  instructor            String?
  libraryId             String?
  zoneSecurityKey       String?
  views                 Int                 @default(0)
  classComment          classComment[]
  classLike             classLike[]
  classNote             classNote[]
  admin                 admin?              @relation(fields: [adminId], references: [id])
  cycleSubjectChapter   cycleSubjectChapter @relation(fields: [cycleSubjectChapterId], references: [id], onDelete: Cascade)
  videoId               String?
  markedBook            String?
  partIndex             Int?
  //serial
  serial                Int?                @default(1)
  activeChats           activeChat[]

  @@map("cycleContents")
}

model classComment {
  id             String         @id @unique @default(uuid()) @db.Uuid
  classContentId String?        @db.Uuid
  cycleContentId String?        @db.Uuid
  studentId      String?        @db.Uuid
  adminId        String?        @db.Uuid
  comment        String
  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  parentId       String?        @db.Uuid
  classContent   classContent?  @relation(fields: [classContentId], references: [id], onDelete: Cascade)
  cycleContent   cycleContent?  @relation(fields: [cycleContentId], references: [id], onDelete: Cascade)
  parent         classComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        classComment[] @relation("CommentReplies")
  admin          admin?         @relation(fields: [adminId], references: [id])
  student        student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("classComments")
}

model classLike {
  id             String        @id @unique @default(uuid()) @db.Uuid
  classContentId String?       @db.Uuid
  cycleContentId String?       @db.Uuid
  createdAt      DateTime      @default(now())
  classContent   classContent? @relation(fields: [classContentId], references: [id], onDelete: Cascade)
  cycleContent   cycleContent? @relation(fields: [cycleContentId], references: [id], onDelete: Cascade)
  type           ReactionType
  studentId      String?       @db.Uuid
  student        student?      @relation(fields: [studentId], references: [id])
  adminId        String?       @db.Uuid
  admin          admin?        @relation(fields: [adminId], references: [id])

  @@unique([classContentId, studentId])
  @@unique([cycleContentId, studentId])
  @@unique([classContentId, adminId])
  @@unique([cycleContentId, adminId])
  @@map("classLikes")
}

model classNote {
  id             String        @id @unique @default(uuid()) @db.Uuid
  classContentId String?       @db.Uuid
  cycleContentId String?       @db.Uuid
  studentId      String        @db.Uuid
  note           String
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  classContent   classContent? @relation(fields: [classContentId], references: [id], onDelete: Cascade)
  cycleContent   cycleContent? @relation(fields: [cycleContentId], references: [id], onDelete: Cascade)
  student        student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classContentId, studentId])
  @@unique([cycleContentId, studentId])
  @@map("classNotes")
}

model featured {
  id       String  @id @unique @default(uuid()) @db.Uuid
  courseId String? @db.Uuid

  //serial
  serial Int? @default(1)

  title               String
  description         String?
  url                 String
  image               String?
  coupne              String?
  adminId             String?   @db.Uuid
  createdAt           DateTime  @default(now())
  isDeleted           Boolean   @default(false)
  updatedAt           DateTime  @updatedAt
  endTime             DateTime?
  startTime           DateTime?
  type                String?
  cycleId             String?   @db.Uuid
  productId           String?
  affiliateProductIds String[]  @default([])
  admin               admin?    @relation(fields: [adminId], references: [id])
  course              course?   @relation(fields: [courseId], references: [id])
  cycle               cycle?    @relation(fields: [cycleId], references: [id])
}

model noticeORroutine {
  id          String    @id @unique @default(uuid()) @db.Uuid
  courseId    String?   @db.Uuid
  title       String?
  description String?
  image       String?
  url         String?
  type        String?
  startTime   DateTime?
  endTime     DateTime?
  adminId     String?   @db.Uuid
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cycleId     String?   @db.Uuid
  admin       admin?    @relation(fields: [adminId], references: [id])
  course      course?   @relation(fields: [courseId], references: [id])
  cycle       cycle?    @relation(fields: [cycleId], references: [id])
}

model liveClass {
  id                     String    @id @unique @default(uuid()) @db.Uuid
  title                  String?
  description            String?
  adminId                String    @db.Uuid
  startTime              DateTime
  endTime                DateTime?
  url                    String?
  secondaryUrl           String?
  videoId                String?
  hostingType            String?
  yt                     String?
  vimeo                  String? //temp store class number
  raw                    String?
  rec                    String?
  stream                 String?
  libraryId              String?
  thumbnail              String?
  thumbnailPath          String?
  thumbnail256x144Path   String?
  slidesUrl              String?
  hotspotUrl             String?
  lectureSheet           String?
  practiceSheet          String?
  solutionSheet          String?
  noteUrl                String?
  markedBook             String?
